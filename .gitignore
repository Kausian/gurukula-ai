# Miscellaneous
*.class
*.log
.shots/
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (contains project identifiers; add locally, do not commit)
/android/app/google-services.json
lib/firebase_options.dart

# Release signing secrets and build artifacts (v1.28.0) — never commit these.
# (android/.gitignore already ignores key.properties/*.jks/*.keystore; these
# repo-wide rules are a belt-and-suspenders safety net.)
key.properties
*.jks
*.keystore
*.apk
*.aab
# key.properties.example (placeholders only) is intentionally NOT ignored.
